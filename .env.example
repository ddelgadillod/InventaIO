# ============================================================
# InventAI/o — Bodega de Datos
# Copiar a .env y ajustar si es necesario
# ============================================================

# PostgreSQL
POSTGRES_DB=inventaio
POSTGRES_USER=inventaio_user
POSTGRES_PASSWORD=inventaio_pass_2025
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ETL
RANDOM_SEED=42

# NLP Agent (INV-30) — docs/NLP-AGENT.md
# Ollama nativo en WSL (scripts/ollama_wsl.sh): host.docker.internal desde Docker,
# localhost fuera de Docker. Con el perfil `llm`: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODELO=qwen3:8b
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m
LLM_RAZONAMIENTO=false
LLM_TIMEOUT_S=120
# Cada llamada de una herramienta al Core API (INV-32, T10)
CORE_API_TIMEOUT_S=60
