# ============================================================
# InventAI/o — Desarrollo local
# Copiar a .env y ajustar si es necesario. Los valores son los de
# prueba del repositorio: solo valen con ENTORNO=desarrollo. Para la
# nube, .env.prod.example (INV-66)
# ============================================================

# Sin esta variable se asume producción y el Core API y el ML Service
# no arrancan con estos valores (INV-66)
ENTORNO=desarrollo

# PostgreSQL
POSTGRES_DB=inventaio
POSTGRES_USER=inventaio_user
POSTGRES_PASSWORD=inventaio_pass_2025
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Core API (INV-66): sin JWT_SECRET_KEY usa la de prueba; CORS vacío porque
# Vite pasa /api al 8000 por proxy (mismo origen); límite de login
CORS_ORIGENES=
LOGIN_MAX_FALLOS_USUARIO_IP=5
LOGIN_MAX_FALLOS_IP=20
LOGIN_VENTANA_S=900

# ETL
RANDOM_SEED=42

# NLP Agent (INV-30) — docs/NLP-AGENT.md
# ollama, o bedrock (INV-67): con bedrock, las credenciales salen de la cadena de AWS
# (AWS_PROFILE o el rol de la EC2), nunca de este archivo
LLM_PROVEEDOR=ollama
# Ollama nativo en WSL (scripts/ollama_wsl.sh): host.docker.internal desde Docker,
# localhost fuera de Docker. Con el perfil `llm`: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODELO=qwen3:8b
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m
LLM_RAZONAMIENTO=false
LLM_TIMEOUT_S=120
# Tope de tokens por ronda (num_predict) y prompts de INV-33 — docs/INV-33-prompts-flujo.md
LLM_TOPE_RESPUESTA=2048
PROMPT_VERSION=v2
# completo, o corto para CPU (Z8)
PERFIL_PROMPT=completo
FIDELIDAD_RETENER=true
# Interruptores de INV-33 §5, apagados (holdout-3, 24-oct)
MEJORAS=ninguna
# Amazon Bedrock (INV-67), solo con LLM_PROVEEDOR=bedrock
BEDROCK_REGION=us-east-2
BEDROCK_ENDPOINT=runtime
# Cada llamada de una herramienta al Core API (INV-32, T10)
CORE_API_TIMEOUT_S=60

# Chat del Core API (INV-36) — docs/INV-36-requerimientos.md §4.4
NLP_AGENT_URL=http://nlp-agent:8002
CHAT_TIMEOUT_S=120
CHAT_ESPERA_INICIO_S=15
CHAT_MAX_FLUJOS=1
CHAT_RETRY_AFTER_S=10
CHAT_MARGEN_TOKEN_S=120
CHAT_MAX_MENSAJES=13
CHAT_MAX_CARACTERES_MENSAJE=2000
CHAT_MAX_CARACTERES_TOTAL=16000
