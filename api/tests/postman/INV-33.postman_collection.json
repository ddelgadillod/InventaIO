    "name": "InventaIO · INV-33 · Endpoints del agente (brechas B1–B4)",
    "description": "Casos del reporte de ventas con producto, trimestre y año (B4, cambio del Core API) y de los endpoints que usan las herramientas nuevas del agente (resumen_inventario, recomendar_traslados y la búsqueda por código), contra la bodega real (foto al 2025-12-31) con los usuarios de prueba. Especificación: docs/INV-33-requerimientos.md (§3b).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Inicia sesión con los usuarios de prueba si falta un token o está por vencer",
          "// (duran 30 min). Así cualquier caso se puede correr solo.",
          "const usuarios = {\"gerente\": \"gerente\", \"norte\": \"admin.norte\", \"principal\": \"admin.principal\"};",
          "if (!pm.request.url.toString().includes(\"/auth/login\")) {",
          "    const ahora = Date.now();",
          "    Object.entries(usuarios).forEach(([rol, usuario]) => {",
          "        const vence = Number(pm.collectionVariables.get(`vence_${rol}`) || 0);",
          "        if (pm.collectionVariables.get(`token_${rol}`) && vence > ahora) return;",
          "        pm.sendRequest({",
          "            url: pm.variables.get(\"baseUrl\") + \"/api/auth/login\",",
          "            method: \"POST\",",
          "            header: [{key: \"Content-Type\", value: \"application/json\"}],",
          "            body: {mode: \"raw\", raw: JSON.stringify({email: `${usuario}@inventaio.co`, password: pm.variables.get(\"password\")})}",
          "        }, (err, res) => {",
          "            if (err || res.code !== 200) { console.error(`Login de ${usuario}: ${err || res.code}`); return; }",
          "            pm.collectionVariables.set(`token_${rol}`, res.json().access_token);",
          "            pm.collectionVariables.set(`vence_${rol}`, String(ahora + 25 * 60 * 1000));",
          "        });",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Sin error 500\", () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
