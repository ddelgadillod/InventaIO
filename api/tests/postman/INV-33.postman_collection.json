      "item": [
        {
          "name": "VP-01 · P626 por trimestre, todo el histórico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"16 trimestres, de 2022-T1 a 2025-T4\", () => pm.expect([d.items.length, d.items[0].periodo, d.items[15].periodo]).to.eql([16, \"2022-T1\", \"2025-T4\"]));",
                  "pm.test(\"42.434 unidades en total; 4.706 en 2025-T4\", () => pm.expect([d.total_cantidad, d.items[15].cantidad]).to.eql([42434, 4706]));",
                  "pm.test(\"Agrupación trimestre\", () => pm.expect(d.agrupacion).to.eql(\"trimestre\"));",
                  "pm.test(\"Producto P626 · ARROZ DIANA *500 GR · unidad\", () => pm.expect(d.producto).to.eql({codigo: \"P626\", nombre: \"ARROZ DIANA *500 GR\", unidad: \"unidad\"}));",
                  "pm.test(\"La suma de los periodos es el total\", () => pm.expect(d.items.reduce((s, i) => s + i.cantidad, 0)).to.be.closeTo(d.total_cantidad, 0.001));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reportes/ventas?producto=P626&agrupacion=trimestre&fecha_inicio=2000-01-01",
