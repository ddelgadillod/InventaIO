        {
          "name": "Gerente: alertas críticas en GLORIETA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 text/event-stream\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test(\"X-Accel-Buffering: no (Nginx lo consume) y X-Request-Id de 32 hex\", () => {",
                  "    // El Core API lo envía; Nginx lo usa y no lo pasa al navegador: por el 8080 no llega",
                  "    const xab = pm.response.headers.get('X-Accel-Buffering');",
                  "    pm.expect(xab === undefined || xab === 'no').to.be.true;",
                  "    pm.expect(pm.response.headers.get('X-Request-Id')).to.match(/^[0-9a-f]{32}$/);",
                  "});",
                  "// El cuerpo SSE completo: un evento por bloque «event: x / data: {...}»; los «: ping» son comentarios",
                  "const bloques = pm.response.text().trim().split('\\n\\n');",
                  "const eventos = bloques.filter(b => b.startsWith('event: ')).map(b => ({",
                  "    nombre: b.split('\\n')[0].slice(7),",
                  "    datos: JSON.parse((b.split('\\n').find(l => l.startsWith('data: ')) || 'data: {}').slice(6))}));",
                  "pm.test(\"meta primero, con el mismo request_id\", () => {",
                  "    pm.expect(eventos[0].nombre).to.eql('meta');",
                  "    pm.expect(eventos[0].datos.request_id).to.eql(pm.response.headers.get('X-Request-Id'));",
                  "});",
                  "pm.test(\"done al final, con rondas y fechas_datos (contrato v1)\", () => {",
                  "    const done = eventos[eventos.length - 1];",
                  "    pm.expect(done.nombre).to.eql('done');",
                  "    pm.expect(done.datos).to.have.keys('tokens_prompt', 'tokens_respuesta', 'ms_total', 'ms_modelo', 'ms_herramientas', 'rondas', 'fechas_datos');",
                  "});",
                  "pm.test(\"Hubo herramienta y texto\", () => {",
                  "    pm.expect(eventos.map(e => e.nombre)).to.include.members(['tool', 'token']);",
                  "});",
                  "pm.test(\"Hay data con fecha_dato\", () => pm.expect(eventos.find(e => e.nombre === 'data').datos.fecha_dato).to.eql('2025-12-31'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
