# ============================================================
# InventAI/o — Variables de docker-compose.prod.yml (INV-66 e INV-34)
# Copiar a .env.prod (no se versiona) y llenar lo que está vacío.
# En staging, scripts/desplegar_staging.sh --primera-vez la copia y llena
# los secretos y el dominio en la instancia (INV-34, C7).
# Cada secreto se genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# staging o produccion: con cualquiera de los dos, los servicios no arrancan con los valores de prueba
ENTORNO=staging

# Tag de las imágenes de GHCR: vX.Y.Z o sha-xxxxxxx (docs/CI-CD.md). desplegar_staging.sh lo pasa al desplegar
INVENTAIO_TAG=
# INVENTAIO_REGISTRO=ghcr.io/ddelgadillod

# Dominio que sirve Caddy con TLS (INV-34, C4), sin https://. Con localhost usa su CA interna
DOMINIO=

# Puertos del host hacia Caddy
PUERTO_HTTP=80
PUERTO_HTTPS=443

# PostgreSQL
POSTGRES_DB=inventaio
POSTGRES_USER=inventaio_user
POSTGRES_PASSWORD=

# JWT del Core API: mínimo 32 bytes
JWT_SECRET_KEY=

# Vacío: sin CORS, porque Nginx sirve la aplicación y /api desde el mismo origen
CORS_ORIGENES=

# Límite de intentos fallidos de login (por email e IP, por IP y ventana en segundos)
LOGIN_MAX_FALLOS_USUARIO_IP=5
LOGIN_MAX_FALLOS_IP=20
LOGIN_VENTANA_S=900

# Bucket del traslado de la bodega (INV-34, §7 de los requerimientos): lo lee scripts/bd/restaurar_staging.sh
BUCKET_VOLCADOS=

# Agente: Qwen3-32B en Bedrock con el rol de la instancia, sin llaves (D26, INV-67)
LLM_PROVEEDOR=bedrock
LLM_MODELO=qwen.qwen3-32b-v1:0
BEDROCK_REGION=us-east-2
PERFIL_PROMPT=completo
# Con Ollama en CPU en lugar de Bedrock: LLM_PROVEEDOR=ollama, LLM_MODELO=qwen3:8b y el perfil `llm`
# OLLAMA_BASE_URL=http://ollama:11434
